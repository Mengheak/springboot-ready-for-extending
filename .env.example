# --- Database ---
# DB_USERNAME is used by both docker-compose (POSTGRES_USER) and the app datasource.
DB_NAME=demo_db
DB_USERNAME=setup_sb
DB_PASSWORD=<replace with real password>
DB_PORT=5432

# --- Application ---
APP_PORT=8080
# dev | prod — docker-compose falls back to dev when unset
ACTIVE_PROFILE=dev

JWT_SECRET=<replace with real secret key>

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
